{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codepulse:feature-requirements-input:1.0",
  "title": "CodePulse Structured Requirements Input",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "applicationName", "requirements"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "applicationName": {"$ref": "#/$defs/text"},
    "requirements": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/requirement"}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S", "maxLength": 4000},
    "texts": {"type": "array", "uniqueItems": true, "maxItems": 1000, "items": {"$ref": "#/$defs/text"}},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "domain", "capabilityType", "actors", "inputs", "outputs", "preconditions", "behaviors", "acceptanceCriteria", "ambiguities"],
      "properties": {
        "id": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/id"},
        "name": {"$ref": "#/$defs/text"},
        "domain": {"$ref": "#/$defs/text"},
        "capabilityType": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/feature/properties/capabilityType"},
        "actors": {"$ref": "#/$defs/texts"},
        "inputs": {"$ref": "#/$defs/texts"},
        "outputs": {"$ref": "#/$defs/texts"},
        "preconditions": {"$ref": "#/$defs/texts"},
        "acceptanceCriteria": {"$ref": "#/$defs/texts"},
        "ambiguities": {"$ref": "#/$defs/texts"},
        "behaviors": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "description", "mandatory"],
            "properties": {
              "id": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/id"},
              "description": {"$ref": "#/$defs/text"},
              "mandatory": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}