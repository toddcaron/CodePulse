{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codepulse:feature-parity-config:1.0",
  "title": "CodePulse Finder Configuration",
  "type": "object",
  "required": ["featureParity"],
  "properties": {
    "featureParity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "applicationName": {"type": "string", "minLength": 1, "maxLength": 200},
        "defaultScope": {"$ref": "#/$defs/scopes"},
        "include": {"$ref": "#/$defs/patterns"},
        "exclude": {"$ref": "#/$defs/patterns"},
        "forbiddenPaths": {"$ref": "#/$defs/patterns"},
        "minimumConfidence": {"enum": ["low", "medium", "high"]},
        "limits": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "maxFileBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "maxEntries": {"type": "integer", "minimum": 1, "maximum": 20000},
            "maxDepth": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        }
      }
    }
  },
  "$defs": {
    "patterns": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["all", "business", "ui", "api", "integrations", "reports", "jobs", "authorization", "data-operations"]}}
  }
}