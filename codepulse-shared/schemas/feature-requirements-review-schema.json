{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codepulse:feature-requirements-review:1.0",
  "title": "CodePulse Reviewed Requirements Contracts",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "baselineDigest", "decisions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "baselineDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
    "decisions": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirementId", "expectedRequirementDigest", "approvedReference", "contract", "criteriaMappings"],
        "properties": {
          "requirementId": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/id"},
          "expectedRequirementDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
          "approvedReference": {"type": "string", "pattern": "\\S", "maxLength": 1000},
          "contract": {"$ref": "urn:codepulse:feature-requirements-input:1.0#/$defs/requirement"},
          "criteriaMappings": {
            "type": "array", "maxItems": 1000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["criterion", "behaviorIds"],
              "properties": {
                "criterion": {"$ref": "urn:codepulse:feature-requirements-input:1.0#/$defs/text"},
                "behaviorIds": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/refs", "minItems": 1}
              }
            }
          }
        }
      }
    }
  }
}