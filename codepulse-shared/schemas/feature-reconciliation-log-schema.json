{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codepulse:feature-reconciliation-log:1.0",
  "title": "CodePulse Review Reconciliation Audit",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "inputManifestDigest", "reviewBatchDigest", "outputManifestDigest", "changes", "statistics", "evidenceVerificationChanged", "confidenceChanged", "applicationCodeExecuted"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "engineVersion": {"type": "string", "minLength": 1},
    "inputManifestDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
    "reviewBatchDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
    "outputManifestDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
    "evidenceVerificationChanged": {"const": false},
    "confidenceChanged": {"const": false},
    "applicationCodeExecuted": {"const": false},
    "changes": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["featureId", "decision", "approvedReference", "beforeDigest", "afterDigest"],
        "properties": {
          "featureId": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/id"},
          "decision": {"enum": ["confirmed", "needs-review", "rejected", "deprecated"]},
          "approvedReference": {"type": "string", "pattern": "\\S"},
          "beforeDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"},
          "afterDigest": {"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"}
        }
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["appliedDecisions", "confirmedFeatures", "rejectedFeatures", "deprecatedFeatures", "needsReview", "reviewQueueItems"],
      "properties": {
        "appliedDecisions": {"$ref": "#/$defs/count"},
        "confirmedFeatures": {"$ref": "#/$defs/count"},
        "rejectedFeatures": {"$ref": "#/$defs/count"},
        "deprecatedFeatures": {"$ref": "#/$defs/count"},
        "needsReview": {"$ref": "#/$defs/count"},
        "reviewQueueItems": {"$ref": "#/$defs/count"}
      }
    }
  },
  "$defs": {"count": {"type": "integer", "minimum": 0}}
}