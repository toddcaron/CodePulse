{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codepulse-report-schema.json",
  "title": "{skillName} Report",
  "description": "Single source of data for every rendered CodePulse report. Persist as {skill_name}_{currentDate}-result.json beside the rendered report. Every assessment embeds complete normalized finding records so the JSON is self-contained and renderer-independent. Renderers in ../renderers/ read only this object.",
  "type": "object",
  "required": ["schemaVersion", "reportType", "skillName", "application", "repository", "assessmentDate"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "reportType": { "enum": ["detailed", "executive"] },
    "skillName": {
      "enum": [
        "codepulse-full",
        "codepulse-loc",
        "codepulse-vuln",
        "codepulse-vuln-verbose",
        "codepulse-quality",
        "codepulse-deadcode",
        "codepulse-plm",
        "codepulse-ext",
        "codepulse-exec"
      ]
    },
    "application": { "type": "string" },
    "repository": { "type": "string" },
    "assessmentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sourceReport": { "type": "string", "description": "Executive only: path of the detailed -result.json summarized." },
    "executiveSummary": { "type": "array", "items": { "type": "string" }, "description": "Short paragraphs." },
    "overall": {
      "type": "object",
      "required": ["score", "grade", "complete"],
      "properties": {
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "grade": { "enum": ["A", "B", "C", "D", null] },
        "complete": { "type": "boolean", "description": "False when any required capability is not complete." },
        "note": { "type": "string", "description": "Effect of incomplete capabilities on score and coverage." }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "methodology": {
      "type": "object",
      "properties": {
        "executedChecks": { "type": "array", "items": { "type": "string" }, "description": "Exact commands or review steps." },
        "tools": { "type": "array", "items": { "type": "string" }, "description": "Tool name and version." },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assessments": {
      "type": "array",
      "items": { "$ref": "assessment-result-schema.json" }
    },
    "topRisks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["findingId"],
        "properties": {
          "findingId": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Ordered per ../references/recommendation-priority.md.",
      "items": {
        "type": "object",
        "required": ["priority", "title"],
        "properties": {
          "priority": { "enum": ["Critical", "High", "Medium", "Low"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "findingIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "modernization": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "findingIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "conclusion": { "type": "string" },
    "executive": { "$ref": "#/$defs/executive" }
  },
  "allOf": [
    {
      "if": { "properties": { "reportType": { "const": "detailed" } } },
      "then": { "required": ["overall", "assessments", "methodology", "limitations"] }
    },
    {
      "if": { "properties": { "reportType": { "const": "executive" } } },
      "then": { "required": ["executive", "sourceReport"] }
    }
  ],
  "$defs": {
    "priority": { "enum": ["Critical", "High", "Medium", "Low"] },
    "executive": {
      "type": "object",
      "description": "Decision-oriented content. No file names, line numbers, source code, or configuration details. Use Not Assessed for any dashboard rating whose category is absent or non-complete in the source result.",
      "required": ["dashboard", "snapshot", "topRisks", "strengths", "investmentPriorities", "modernizationOutlook", "recommendation"],
      "properties": {
        "dashboard": {
          "type": "object",
          "required": ["overallGrade", "securityPosture", "technologyHealth", "maintainability", "operationalRisk", "modernizationReadiness"],
          "properties": {
            "overallGrade": { "enum": ["A", "B", "C", "D", null] },
            "securityPosture": { "enum": ["Strong", "Acceptable", "Needs Attention", "High Risk", "Not Assessed"] },
            "technologyHealth": { "enum": ["Modern", "Current", "Aging", "Legacy", "Not Assessed"] },
            "maintainability": { "enum": ["Excellent", "Manageable", "Challenging", "Poor", "Not Assessed"] },
            "operationalRisk": { "enum": ["Low", "Moderate", "High", "Critical", "Not Assessed"] },
            "modernizationReadiness": { "enum": ["Ready", "Requires Planning", "Significant Investment Required", "Major Modernization Recommended", "Not Assessed"] }
          }
        },
        "snapshot": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
        "topRisks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["risk", "businessImpact", "priority"],
            "properties": {
              "risk": { "type": "string" },
              "businessImpact": { "type": "string" },
              "priority": { "$ref": "#/$defs/priority" },
              "findingIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "strengths": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "investmentPriorities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["area", "whyItMatters", "businessBenefit"],
            "properties": {
              "area": { "type": "string" },
              "whyItMatters": { "type": "string" },
              "businessBenefit": { "type": "string" },
              "priority": { "$ref": "#/$defs/priority" }
            }
          }
        },
        "modernizationOutlook": {
          "type": "object",
          "required": ["complexity", "summary"],
          "properties": {
            "complexity": { "enum": ["Low", "Medium", "High", "Very High"] },
            "summary": { "type": "string" },
            "concerns": { "type": "array", "items": { "type": "string" } },
            "nextSteps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "recommendation": {
          "type": "object",
          "required": ["decision", "rationale"],
          "properties": {
            "decision": { "enum": ["Continue Current Investment", "Monitor Closely", "Prioritize Improvements", "Modernization Recommended", "Immediate Remediation Required"] },
            "rationale": { "type": "string" }
          }
        }
      }
    }
  }
}
