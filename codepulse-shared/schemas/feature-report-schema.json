{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codepulse:feature-report:1.0",
  "title": "CodePulse Feature Parity Report Object",
  "description": "Presentation-independent report data derived only from engine artifacts. Rendered HTML and Markdown contain no facts absent from this object.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "reportType", "title", "methodology", "applications", "digests", "reviewState", "metrics", "formulas", "unresolvedCount", "unresolvedItems", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "engineVersion": {"type": "string", "minLength": 1},
    "reportType": {"enum": ["discovery", "comparison", "requirements-coverage"]},
    "title": {"$ref": "#/$defs/text"},
    "methodology": {"$ref": "#/$defs/text"},
    "semanticStatus": {"enum": ["inventory-only", "incomplete", "complete"]},
    "capabilities": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "name", "domain", "status", "summary", "businessRules", "unresolvedQuestions"],
        "properties": {
          "identifier": {"$ref": "#/$defs/text"},
          "name": {"$ref": "#/$defs/text"},
          "domain": {"$ref": "#/$defs/text"},
          "status": {"enum": ["not-started", "complete", "partial", "unresolved"]},
          "summary": {"$ref": "#/$defs/text"},
          "unresolvedQuestions": {"$ref": "#/$defs/texts"},
          "businessRules": {
            "type": "array", "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["condition", "outcome", "basis", "rationale", "evidence"],
              "properties": {
                "condition": {"$ref": "#/$defs/text"},
                "outcome": {"$ref": "#/$defs/text"},
                "basis": {"enum": ["observed", "inferred"]},
                "rationale": {"$ref": "#/$defs/text"},
                "evidence": {"type": "array", "items": {"$ref": "#/$defs/text"}}
              }
            }
          }
        }
      }
    },
    "applications": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "name", "sourceType", "revision", "coverage", "limitations"],
        "properties": {
          "role": {"enum": ["scanned", "baseline", "target", "requirements"]},
          "name": {"$ref": "#/$defs/text"},
          "sourceType": {"type": ["string", "null"], "enum": ["repository", "requirements", null]},
          "revision": {"type": ["string", "null"], "maxLength": 4000},
          "coverage": {"enum": ["complete-in-scope", "incomplete", "unknown"]},
          "limitations": {"$ref": "#/$defs/texts"}
        }
      }
    },
    "digests": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": {"$ref": "#/$defs/text"},
          "value": {"anyOf": [{"$ref": "urn:codepulse:feature-manifest:1.0#/$defs/hash"}, {"type": "null"}]}
        }
      }
    },
    "reviewState": {"$ref": "#/$defs/measures"},
    "metrics": {"$ref": "#/$defs/measures"},
    "formulas": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "expression", "value"],
        "properties": {
          "label": {"$ref": "#/$defs/text"},
          "expression": {"$ref": "#/$defs/text"},
          "value": {"type": ["number", "null"]}
        }
      }
    },
    "unresolvedCount": {"type": "integer", "minimum": 0},
    "unresolvedItems": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "status", "detail"],
        "properties": {
          "identifier": {"$ref": "#/$defs/text"},
          "status": {"$ref": "#/$defs/text"},
          "detail": {"$ref": "#/$defs/text"}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S", "maxLength": 4000},
    "texts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/text"}},
    "measures": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": {"$ref": "#/$defs/text"},
          "value": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
